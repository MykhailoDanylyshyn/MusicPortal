@model RecordDTO
@{ ViewData["Title"] = Model.Title; var canManage = User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.HasClaim("approved", "true")); }
<div class="form-page"><a asp-action="Index" class="back-link">← @Localizer["Text_019"]</a><div class="detail-card"><div class="detail-cover">♫</div><span class="eyebrow">@Model.GenreName</span><h1>@Model.Title</h1><p class="detail-artist">@(Model.ArtistName ?? Localizer["Text_017"])</p><audio controls src="@Model.AudioUrl"></audio>@if (canManage) { <div class="form-actions"><a class="btn-primary-custom" asp-action="Edit" asp-route-id="@Model.Id">@Localizer["Text_042"]</a><a class="btn-quiet" asp-action="Delete" asp-route-id="@Model.Id">@Localizer["Text_043"]</a></div> }</div></div>
