@model PaginatedRecordsViewModel
@{ ViewData["Title"] = @Localizer["Text_033"]; }
<div class="page-heading"><div><span class="eyebrow">@Localizer["Text_034"]</span><h1>@Localizer["Text_033"]</h1><p>@Localizer["Text_035"]</p></div><a class="btn-primary-custom" asp-action="Create">＋ @Localizer["Text_015"]</a></div>
<form method="get" class="filter-bar"><div class="search-wrap"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="@Localizer["Text_036"]" /></div><select name="genreId" asp-items="ViewBag.Genres"><option value="">@Localizer["Text_037"]</option></select><button class="btn-filter" type="submit">@Localizer["Text_038"]</button><a class="btn-reset" asp-action="Index">@Localizer["Text_039"]</a></form>
@if (!Model.Items.Any()) { <div class="empty-state"><div class="empty-icon">♫</div><h3>@Localizer["Text_040"]</h3><p>@Localizer["Text_041"]</p><a class="btn-primary-custom" asp-action="Create">@Localizer["Text_015"] <span>＋</span></a></div> }
else { <div class="catalog-list">@foreach (var item in Model.Items) { <article class="track-row"><div class="track-art">♫</div><div class="track-main"><a asp-action="Details" asp-route-id="@item.Id" class="track-title">@item.Title</a><span>@(item.ArtistName ?? Localizer["Text_017"]) · @item.GenreName</span></div><audio controls preload="none" src="@item.AudioUrl"></audio><div class="track-actions"><a asp-action="Edit" asp-route-id="@item.Id" title="@Localizer["Text_042"]">✎</a><a asp-action="Delete" asp-route-id="@item.Id" title="@Localizer["Text_043"]">×</a></div></article> }</div>
<pagination current-page="@Model.CurrentPage" total-pages="@Model.TotalPages" action="Index" controller="Records"></pagination> }

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const players = document.querySelectorAll('audio');

            players.forEach(function (player) {
                player.addEventListener('play', function () {
                    players.forEach(function (otherPlayer) {
                        if (otherPlayer !== player) {
                            otherPlayer.pause();
                        }
                    });
                });
            });
        });
    </script>
}
