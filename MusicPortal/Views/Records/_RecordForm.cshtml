@model RecordFormViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
 <div class="field-group full"><label asp-for="Title">@Localizer["TrackTitleLabel"]</label><input asp-for="Title" class="form-control" placeholder="@Localizer["Text_044"]" /><span asp-validation-for="Title" class="field-error"></span></div>
 <div class="field-group"><label asp-for="ArtistId">@Localizer["ArtistSelectLabel"]</label><select asp-for="ArtistId" asp-items="Model.Artists" class="form-select"><option value="">@Localizer["Text_045"]</option></select><span class="field-hint">@Localizer["Text_046"]</span><input asp-for="NewArtistName" class="form-control mt-2" placeholder="@Localizer["Text_047"]" /><span asp-validation-for="NewArtistName" class="field-error"></span></div>
 <div class="field-group"><label asp-for="GenreId">@Localizer["GenreSelectLabel"]</label><select asp-for="GenreId" asp-items="Model.Genres" class="form-select"><option value="">@Localizer["Text_048"]</option></select><span class="field-hint">@Localizer["Text_049"]</span><input asp-for="NewGenreName" class="form-control mt-2" placeholder="@Localizer["Text_050"]" /><span asp-validation-for="GenreId" class="field-error"></span><span asp-validation-for="NewGenreName" class="field-error"></span></div>
 <div class="field-group full"><label asp-for="AudioFile">@Localizer["AudioFileLabel"]</label><div class="upload-zone"><div class="upload-symbol">⇧</div><div><strong>@Localizer["Text_051"]</strong><p>@Localizer["AudioFormats"]</p><input asp-for="AudioFile" type="file" class="form-control" accept=".mp3,.wav,.ogg,.m4a,audio/*" /></div></div><span asp-validation-for="AudioFile" class="field-error"></span>@if (!string.IsNullOrEmpty(Model.ExistingAudioUrl)) { <div class="field-hint mt-2">@Localizer["Text_052"] <a href="@Model.ExistingAudioUrl" target="_blank">@Localizer["Text_053"]</a>. @Localizer["Text_054"]</div> }</div>
</div>
<div class="form-actions"><button type="submit" class="btn-primary-custom">@Localizer["Text_055"] <span>→</span></button><a asp-action="Index" class="btn-quiet">@Localizer["Text_056"]</a></div>
