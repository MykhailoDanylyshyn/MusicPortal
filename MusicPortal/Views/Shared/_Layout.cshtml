@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{ var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name; }
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b12" />
    <title>@ViewData["Title"] · MUSIC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-spa.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg container">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">♫</span> MUSIC<span class="brand-dot">.</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="mainNav">
            <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <a class="nav-link" asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a>
                <a class="nav-link" asp-controller="Records" asp-action="Index">@Localizer["Nav_Catalog"]</a>
                <a class="nav-link" asp-controller="Artists" asp-action="Index">@Localizer["Nav_Artists"]</a>
                <a class="nav-link" asp-controller="Genres" asp-action="Index">@Localizer["Nav_Genres"]</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Адміністрування</a>
                }
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.HasClaim("approved", "true")))
                {
                    <a class="nav-cta" asp-controller="Records" asp-action="Create">＋ @Localizer["Nav_AddRecord"]</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-link">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">Вийти</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Увійти</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
                }
                <form asp-controller="Language" asp-action="SetLanguage" method="post" class="ms-lg-2 d-flex align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <select name="culture" class="form-select form-select-sm" aria-label="@Localizer["Language"]" onchange="this.form.submit()">
                        <option value="uk-UA" selected="@(currentCulture == "uk-UA")">UA</option>
                        <option value="en-US" selected="@(currentCulture == "en-US")">EN</option>
                    </select>
                </form>
            </div>
        </div>
    </nav>
</header>
<main class="container page-shell">
    @if (TempData["Info"] is string info) { <div class="alert alert-info alert-dismissible fade show" role="alert">@info<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
<footer class="site-footer"><div class="container d-flex justify-content-between flex-wrap gap-2"><span>♫ MUSIC — @Localizer["Footer_Tagline"]</span><span>@Localizer["Footer_Slogan"]</span></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
