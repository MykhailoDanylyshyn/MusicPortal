@model IEnumerable<GenreDTO>
@{ ViewData["Title"] = @Localizer["Text_091"]; var canManage = User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.HasClaim("approved", "true")); }
<div class="page-heading"><div><span class="eyebrow">@Localizer["Text_093"]</span><h1>@Localizer["Text_092"]</h1><p>@Localizer["Text_094"]</p></div>@if (canManage) { <a class="btn-primary-custom" asp-action="Create">＋ @Localizer["Text_068"]</a> }</div>
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">◈</div><h3>@Localizer["Text_095"]</h3><p>@Localizer["Text_096"]</p>@if (canManage) { <a class="btn-primary-custom" asp-action="Create">@Localizer["Text_068"]</a> }</div> }
else { <div class="genre-grid">@foreach (var item in Model) { <article class="genre-card"><div class="genre-glyph">◈</div><h3>@item.Name</h3><p>@(item.Description ?? Localizer["Text_097"])</p><span class="field-hint">@Localizer["TrackCountPrefix"]@item.RecordCount</span>@if (canManage) { <div class="entity-actions"><a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Text_042"]</a><a asp-action="Delete" asp-route-id="@item.Id">@Localizer["Text_043"]</a></div> }</article> }</div> }
