@model LoginViewModel
@{
    ViewData["Title"] = "Вхід";
}
<section class="section-block" style="max-width:560px;margin:40px auto;">
    <div class="section-heading"><div><span class="eyebrow">MUSIC PORTAL</span><h2>Вхід до облікового запису</h2></div></div>
    <form asp-action="Login" method="post" class="card p-4 border-0" style="background:#171522;color:#fff;border-radius:18px;">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autocomplete="username" /><span asp-validation-for="Username" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <button type="submit" class="btn-primary-custom border-0">Увійти</button>
        <p class="mt-3 mb-0">Ще не зареєстровані? <a asp-action="Register">Створити обліковий запис</a></p>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
