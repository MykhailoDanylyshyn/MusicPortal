@model IEnumerable<ArtistDTO>
@{ ViewData["Title"] = @Localizer["Text_075"]; }
<div class="page-heading"><div><span class="eyebrow">@Localizer["Text_076"]</span><h1>@Localizer["Text_075"]</h1><p>@Localizer["Text_077"]</p></div><a class="btn-primary-custom" asp-action="Create">＋ @Localizer["Text_060"]</a></div>
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">♬</div><h3>@Localizer["Text_078"]</h3><p>@Localizer["Text_079"]</p><a class="btn-primary-custom" asp-action="Create">@Localizer["Text_060"]</a></div> }
else { <div class="entity-grid">@foreach (var item in Model) { <article class="entity-card"><div class="entity-avatar">@(item.Name.Length > 0 ? item.Name[..1].ToUpper() : "♫")</div><div class="entity-copy"><h3>@item.Name</h3><p>@(item.Country ?? Localizer["Text_080"])</p><span>@(item.Biography ?? Localizer["Text_081"]) · @Localizer["Text_084"] @item.RecordCount</span></div><div class="entity-actions"><a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Text_042"]</a><a asp-action="Delete" asp-route-id="@item.Id">@Localizer["Text_043"]</a></div></article> }</div> }
